node_modules/
# Hardhat: ignore build tree except optional pinned DelegateProxyCaller ABI (deploy + Python without compile)
artifacts/*
!artifacts/contracts/
artifacts/contracts/*
!artifacts/contracts/DelegateProxyCaller.sol/
artifacts/contracts/DelegateProxyCaller.sol/*
!artifacts/contracts/DelegateProxyCaller.sol/DelegateProxyCaller.json
# Hardhat compiler build metadata (large, regenerated on compile)
artifacts/build-info/
cache/
# Python / packaging build outputs
build/
dist/
*.egg-info/
.env
# Local TLS key material (see run_server.sh)
ssl/*.pem
ssl/*.key
*.log
.DS_Store
__pycache__/
*.pyc
.pytest_cache/
venv/

# Rust / Cargo
target/
**/target/
*.pdb
*.rs.bk
